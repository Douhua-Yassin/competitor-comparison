LINGXING_APP_ID=
LINGXING_APP_SECRET=
LINGXING_BASE_URL=https://openapi.lingxing.com

# 可选：仅在需要限制到单个店铺时填写领星店铺 SID。
LINGXING_SID=

# 接口盘点配置。日常报告同步固定使用最近14个自然日。
LINGXING_AUDIT_LOOKBACK_DAYS=7
LINGXING_AUDIT_TIMEOUT_SECONDS=60

# 可选：配置后，Word 报告会使用 DeepSeek 融合数据和人工记录。
# 未配置或调用失败时，程序仍会生成规则版 Word 报告。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
