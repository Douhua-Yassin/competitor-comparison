LINGXING_APP_ID=
LINGXING_APP_SECRET=
LINGXING_BASE_URL=https://openapi.lingxing.com

# 可选：仅在需要限制到单个店铺时填写领星店铺 SID。
LINGXING_SID=

# 接口盘点配置。日常报告同步固定使用最近14个自然日。
LINGXING_AUDIT_LOOKBACK_DAYS=7
LINGXING_AUDIT_TIMEOUT_SECONDS=60

# 目标从Excel导入，不在网页填写。相对路径以项目根目录为准。
REPORT_TARGETS_FILE=目标表.xlsx

# 可选：配置后，Word报告会使用DeepSeek融合确定数据、目标和人工记录。
# 返回结构或数字校验失败时，程序保留失败原因并自动生成规则版报告。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90
